# Copy to .env.local and fill in real values. .env.local is gitignored.

# Webflow Data API v2 — https://developers.webflow.com/data/reference/rest-introduction
WEBFLOW_API_TOKEN=
WEBFLOW_SITE_ID=
WEBFLOW_POSTS_COLLECTION_ID=
WEBFLOW_SERVICES_COLLECTION_ID=

# Site URL used in metadata, sitemap, and structured data
NEXT_PUBLIC_SITE_URL=https://example.com
